#!/usr/bin/env bash
# SDD-Vibe Collision-Free Terminal Activator (macOS / Linux)
# Wraps scripts/init_project.py without conflicting with Python venv 'activate' or shell built-ins.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if command -v python3 >/dev/null 2>&1; then
  PY_CMD="python3"
elif command -v python >/dev/null 2>&1; then
  PY_CMD="python"
else
  echo "[activate-ca-agents] ERROR: Python 3 not found on PATH." >&2
  exit 1
fi

echo "[activate-ca-agents] Bootstrapping SDD-Vibe IDE adapters and verifying workspace..."
"$PY_CMD" scripts/init_project.py --ides all "$@"
"$PY_CMD" scripts/check_docs.py
"$PY_CMD" scripts/manifest.py --check

echo ""
echo "[activate-ca-agents] READY!"
echo "  - Chat: type \"activate ca agents\" or \"/team-ecosystem-ca-agent\" or \"/plan-ca-agent\""
echo "  - Dashboard: type \"/dashboard-ca-agent\" or run bash Project-Manager-Dashboard/open-in-ide.sh"
